{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'section-newsletter-signup.css' | asset_url | stylesheet_tag }}

<script src="{{ 'newsletter-signup.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign art_product = section.settings.artwork_product
  assign art_media = art_product.featured_media
  assign field_id = 'NewsletterSignup-' | append: section.id
  assign message_id = 'NewsletterSignupMessage-' | append: section.id
  assign consent_id = 'NewsletterSignupConsent-' | append: section.id
  assign form_id = 'NewsletterSignupForm-' | append: section.id
-%}

<div class="newsletter-signup color-{{ section.settings.color_scheme }} gradient">
  <div class="newsletter-signup__inner page-width section-{{ section.id }}-padding">
    {%- if section.settings.artwork_image != blank -%}
      <div class="newsletter-signup__art">
        {{
          section.settings.artwork_image
          | image_url: width: 800
          | image_tag: widths: '200, 400, 600, 800', sizes: '(min-width: 750px) 396px, 50vw', loading: 'lazy'
        }}
      </div>
    {%- elsif art_media -%}
      {%- comment -%} Studio shows a small framed piece; reuse the framed-art treatment from studio.css {%- endcomment -%}
      <div class="newsletter-signup__art framed-art">
        <div
          class="media media--transparent media--framed"
          style="--art-ratio: {{ art_media.aspect_ratio }}; --framed-size: {{ section.settings.artwork_frame_size }}; --framed-wall-color: rgb(var(--color-background));"
        >
          {{
            art_media
            | image_url: width: 800
            | image_tag: widths: '200, 400, 600, 800', sizes: '(min-width: 750px) 340px, 40vw', alt: art_media.alt, loading: 'lazy'
          }}
        </div>
      </div>
    {%- endif -%}

    {%- unless section.settings.heading == blank -%}
      <h2 class="newsletter-signup__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
    {%- endunless -%}
    {%- unless section.settings.subheading == blank -%}
      <div class="newsletter-signup__subheading rte">{{ section.settings.subheading }}</div>
    {%- endunless -%}

    <newsletter-signup
      class="newsletter-signup__form-wrap"
      data-message-success="{{ section.settings.success_message | escape }}"
      data-message-error="{{ section.settings.error_message | escape }}"
      data-message-consent="{{ section.settings.consent_error | escape }}"
    >
      {%- form 'customer', class: 'newsletter-form newsletter-signup__form', id: form_id, novalidate: 'novalidate' -%}
        <input type="hidden" name="contact[tags]" value="{{ section.settings.tags | default: 'newsletter' | escape }}">

        {%- comment -%}
          Honeypot: hidden from people and assistive tech. Not prefixed with
          "contact" so Shopify ignores it; the web component rejects any
          submission that fills it in.
        {%- endcomment -%}
        <div class="newsletter-signup__trap" aria-hidden="true">
          <label for="NewsletterSignupWebsite-{{ section.id }}">Leave this field empty</label>
          <input type="text" id="NewsletterSignupWebsite-{{ section.id }}" name="website" tabindex="-1" autocomplete="off">
        </div>

        <div class="newsletter-form__field-wrapper">
          <div class="field">
            <input
              id="{{ field_id }}"
              type="email"
              name="contact[email]"
              class="field__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="{{ section.settings.placeholder | escape }}"
              required
              aria-describedby="{{ message_id }}"
              {% if form.errors %}
                aria-invalid="true"
              {% endif %}
            >
            <label class="field__label" for="{{ field_id }}">{{ section.settings.placeholder | escape }}</label>
            <button
              type="submit"
              class="newsletter-form__button field__button"
              name="commit"
              aria-label="{{ section.settings.button_label | escape }}"
            >
              <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
            </button>
          </div>
        </div>

        {%- if section.settings.show_consent -%}
          <div class="newsletter-signup__consent">
            <input type="checkbox" id="{{ consent_id }}" name="consent" value="yes" required>
            <label for="{{ consent_id }}">{{ section.settings.consent_text }}</label>
          </div>
        {%- endif -%}

        {%- comment -%} Server-rendered state covers no-JS submissions; JS writes here too {%- endcomment -%}
        <p
          id="{{ message_id }}"
          class="newsletter-signup__message{% if form.posted_successfully? %} newsletter-signup__message--success{% elsif form.errors %} newsletter-signup__message--error{% endif %}"
          role="status"
        >
          {%- if form.posted_successfully? -%}
            {{ section.settings.success_message | escape }}
          {%- elsif form.errors -%}
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          {%- endif -%}
        </p>
      {%- endform -%}
    </newsletter-signup>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter signup",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Artwork"
    },
    {
      "type": "image_picker",
      "id": "artwork_image",
      "label": "Image",
      "info": "Shown as-is above the heading."
    },
    {
      "type": "product",
      "id": "artwork_product",
      "label": "Or show a product framed",
      "info": "Used when no image is selected. Its featured image hangs in a frame."
    },
    {
      "type": "range",
      "id": "artwork_frame_size",
      "min": 50,
      "max": 95,
      "step": 1,
      "unit": "%",
      "label": "Frame size",
      "default": 86
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Be the first to know"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subtext",
      "default": "<p>Join our email list to learn about exclusive showings and new collections.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe",
      "info": "Read by screen readers; the button shows an arrow."
    },
    {
      "type": "header",
      "content": "Messages"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing. Watch your inbox for our next showing."
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Invalid email message",
      "default": "Please enter a valid email address."
    },
    {
      "type": "header",
      "content": "Consent"
    },
    {
      "type": "checkbox",
      "id": "show_consent",
      "label": "Require a consent checkbox",
      "default": false
    },
    {
      "type": "inline_richtext",
      "id": "consent_text",
      "label": "Consent text",
      "default": "I agree to receive marketing emails and can unsubscribe at any time."
    },
    {
      "type": "text",
      "id": "consent_error",
      "label": "Consent missing message",
      "default": "Please tick the box to confirm you'd like to receive emails."
    },
    {
      "type": "text",
      "id": "tags",
      "label": "Customer tags",
      "default": "newsletter",
      "info": "Added to the customer in Shopify. Separate with commas."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 68
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 84
    }
  ],
  "presets": [
    {
      "name": "Newsletter signup"
    }
  ]
}
{% endschema %}
